# Production configuration via environment variables (ASP.NET Core maps "__" to ":").
# Locally, prefer user-secrets:  dotnet user-secrets set "Paystack:SecretKey" "sk_test_..." --project PrimeInnovation.Api

ASPNETCORE_ENVIRONMENT=Production

# Required
ConnectionStrings__Default=Server=<host>;Database=PrimeInnovationDb;User Id=<user>;Password=<password>;TrustServerCertificate=True
Jwt__Key=<random string, at least 32 bytes - e.g. `openssl rand -base64 48`>

# Frontend (separate host)
FrontendUrl=https://<frontend-domain>
Cors__Origins__0=https://<frontend-domain>

# Behind a reverse proxy / PaaS load balancer (Azure App Service, Render, Railway, nginx, ...)
ForwardedHeaders__Enabled=true

# Payments - https://dashboard.paystack.com/#/settings/developer
# Webhook URL to register in Paystack: https://<api-domain>/api/payments/paystack/webhook
Paystack__SecretKey=sk_live_xxxxxxxx
Paystack__PublicKey=pk_live_xxxxxxxx

# Optional: Google sign-in (OAuth Web Client ID). Endpoint is disabled when empty.
Google__ClientId=

# Optional: notifications
Email__Enabled=false
Email__Username=
Email__Password=
Termii__ApiKey=

# Seed demo users/courses on first start (demo passwords - do not enable for real production)
Seed__Enabled=false
