# Server secrets: copy to /opt/prod-app/backend/.env and `chmod 600 .env`. Never commit the real file.
# ASP.NET Core maps "__" to ":". Non-secret settings (environment, URLs, migration switch) are in docker-compose.yml.

# --- Required ---------------------------------------------------------------
# SQL Server runs on this host (bare metal); the API uses host networking, so 127.0.0.1 works.
# Use the dedicated promix_app login (db_owner on PrimeInnovationDb only), not sa.
ConnectionStrings__Default=Server=127.0.0.1,1433;Database=PrimeInnovationDb;User Id=promix_app;Password=CHANGE_ME;TrustServerCertificate=True

# Generate with: openssl rand -base64 48
Jwt__Key=CHANGE_ME

# Public URL of the site (used for Paystack callbacks and certificate links).
# Frontend and API share one domain behind host NGINX: / -> frontend, /api -> backend.
FrontendUrl=https://CHANGE_ME
Cors__Origins__0=https://CHANGE_ME

# --- Payments: https://dashboard.paystack.com/#/settings/developer ------------
# Webhook URL to register in Paystack: https://<domain>/api/payments/paystack/webhook
Paystack__SecretKey=
Paystack__PublicKey=

# --- Optional -----------------------------------------------------------------
# Google sign-in (OAuth Web Client ID). Endpoint is disabled when empty.
Google__ClientId=

# Notifications (password reset / welcome / enrollment)
Email__Enabled=false
Email__Host=smtp.gmail.com
Email__Port=587
Email__Username=
Email__Password=
Termii__ApiKey=

# Seeds demo users with PUBLIC passwords. Keep false in production.
Seed__Enabled=false
